  {
   "tool": {
    "driver": {
     "name": "Xinpect",
     "version": "5.163.0",
     "informationUri": "https://xinpect.xingwangzhineng.com",
     "rules": [
      {
       "id": "E1-COR-JFRT-001",
       "shortDescription": {
        "text": "finally 块中使用 throw 会吞掉 try/catch 中抛出的原始异常，导致异常丢失"
       }
      },
      {
       "id": "E2-SEC-JCRP-001/crypto",
       "shortDescription": {
        "text": "Cipher.getInstance 的算法来自配置 cryptoAlg1=\"DES/ECB/PKCS5Padding\"，使用了不安全的加密算法"
       }
      },
      {
       "id": "E2-SEC-JCRP-001/hash",
       "shortDescription": {
        "text": "MessageDigest.getInstance 的算法来自配置 hashAlg1=\"MD5\"，使用了不安全的哈希算法"
       }
      },
      {
       "id": "E2-SEC-JRLC-001",
       "shortDescription": {
        "text": "prepareStatement() 创建的资源未在 try-with-resources 中管理，可能导致资源泄漏"
       }
      },
      {
       "id": "E2-SEC-JV-010",
       "shortDescription": {
        "text": "非密码安全随机数"
       }
      },
      {
       "id": "E2-SEC-JV-040",
       "shortDescription": {
        "text": "XML解析XXE风险"
       }
      },
      {
       "id": "E2-SEC-JVSC-001",
       "shortDescription": {
        "text": "Cookie.setSecure(false) 使 Cookie 可经 HTTP 明文传输，可被中间人窃取"
       }
      },
      {
       "id": "E2-SEC-RND-001",
       "shortDescription": {
        "text": "使用 java.util.Random 生成随机数，它不是加密安全的，不应用于安全敏感场景"
       }
      },
      {
       "id": "E3-PERF-JAVA-LEF-001",
       "shortDescription": {
        "text": "value.equals(\"BenchmarkTest02334\") 可能因 value 为null抛出NPE"
       }
      },
      {
       "id": "E3-PERF-JAVA-NP2-001",
       "shortDescription": {
        "text": "方法 get() 返回值可能为null却直接调用方法，存在NPE风险"
       }
      },
      {
       "id": "E3-PERF-JAVA-SEC-001",
       "shortDescription": {
        "text": "catch 块只有注释，异常被静默吞掉"
       }
      },
      {
       "id": "E3-PERF-JAVA-SWE-001",
       "shortDescription": {
        "text": "catch 块中未使用异常变量 e，异常被静默吞掉"
       }
      },
      {
       "id": "E3-PERF-JAVA-URT-001",
       "shortDescription": {
        "text": "String.replace() 返回值被丢弃，因对象不可变原调用无效果"
       }
      },
      {
       "id": "E3-TAINT-JAVA-001/command_injection",
       "shortDescription": {
        "text": "不可信输入 doSomething() 返回值 流入 r.exec，可导致任意命令执行"
       }
      },
      {
       "id": "E3-TAINT-JAVA-001/ldap_injection",
       "shortDescription": {
        "text": "不可信输入 doSomething() 返回值 流入 idc.search，可导致LDAP 注入"
       }
      },
      {
       "id": "E3-TAINT-JAVA-001/path_traversal",
       "shortDescription": {
        "text": "不可信输入 doSomething() 返回值 流入 java.io.FileOutputStream，可导致任意文件读取/写入"
       }
      },
      {
       "id": "E3-TAINT-JAVA-001/sql_injection",
       "shortDescription": {
        "text": "不可信输入 doSomething() 返回值 流入 statement.executeUpdate，可导致SQL 注入"
       }
      },
      {
       "id": "E3-TAINT-JAVA-001/trust_boundary",
       "shortDescription": {
        "text": "不可信输入 doSomething() 返回值 流入 request.getSession().setAttribute，可导致可信边界违背(不可信输入写入会话)"
       }
      },
      {
       "id": "E3-TAINT-JAVA-001/unspecified",
       "shortDescription": {
        "text": ""
       }
      },
      {
       "id": "E3-TAINT-JAVA-001/xpath_injection",
       "shortDescription": {
        "text": "不可信输入 doSomething() 返回值 流入 xp.compile，可导致XPath 注入"
       }
      },
      {
       "id": "E3-TAINT-JAVA-001/xss",
       "shortDescription": {
        "text": "不可信输入 doSomething() 返回值 流入 response.getWriter().write，可导致XSS 跨站脚本攻击"
       }
      }
     ]
    }
   },
